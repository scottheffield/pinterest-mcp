# Pinterest OAuth 2.0 credentials.
# Copy to .env and fill in. .env is gitignored. Never commit it.
PINTEREST_CLIENT_ID=your_client_id
PINTEREST_CLIENT_SECRET=your_client_secret

# Both values above are also needed AFTER the first auth run: the client uses
# them to refresh the 30-day access token. Do not delete them post-auth.

# After running `pinterest-mcp-auth` the token is stored at
#   ~/.config/pinterest/token.json
# (C:\Users\<you>\.config\pinterest\token.json on Windows), outside this repo.

# --- Optional overrides ---
# Point the server at the API Sandbox host instead of production. Trial access
# blocks pin writes in production; the sandbox is expected to allow them, but
# that path has never been exercised, so treat it as untested.
# PINTEREST_SANDBOX=1
# PINTEREST_SANDBOX_TOKEN=
#
# Load a specific .env instead of searching. Without it the search order is
# the current working directory, then the repo root, then
# ~/.config/pinterest/.env. An MCP client picks the working directory, so set
# this if the server is launched from somewhere unexpected.
# PINTEREST_DOTENV=
# PINTEREST_TOKEN_FILE=C:\Users\you\.config\pinterest\token.json
# PINTEREST_REDIRECT_URI=http://localhost:8089/callback
# Drop ads:read here if the Pinterest app is not approved for it:
# PINTEREST_SCOPES=boards:read,boards:write,pins:read,pins:write,user_accounts:read,ads:read,boards:read_secret,pins:read_secret

# Or supply a token directly, bypassing the auth flow. A token set here takes
# precedence and the stored token file is NOT read, so unset it to go back to
# the stored token and automatic refresh. Without PINTEREST_REFRESH_TOKEN the
# access token cannot be renewed and simply stops working when it expires.
# PINTEREST_ACCESS_TOKEN=
# PINTEREST_REFRESH_TOKEN=
